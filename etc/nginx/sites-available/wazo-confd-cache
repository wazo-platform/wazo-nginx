# Internal confd entry point with a short cache for GET /1.1/users.
# Meant for wazo-dird only: a cache hit never reaches confd, so confd does not
# check the token. Do not expose this listener and do not add other callers.
# Point a dird `wazo` source at it with `confd.port: 9487`.

proxy_cache_path /var/cache/nginx/wazo-confd-users
    levels=1:2 keys_zone=wazo_confd_users:10m max_size=128m inactive=10m
    use_temp_path=off;

# requests with a uuid filter (favorites) vary too much to be worth caching
map $arg_uuid $wazo_confd_users_skip {
    default 1;
    ""      0;
}

server {
    listen 127.0.0.1:9487;
    listen [::1]:9487;
    server_name _;

    access_log /var/log/nginx/wazo-internal.access.log main;
    error_log /var/log/nginx/wazo-internal.error.log;

    client_max_body_size 0;

    location = /1.1/users {
        proxy_pass http://127.0.0.1:9486;
        proxy_set_header Host $http_host;

        proxy_cache wazo_confd_users;
        # the token is not in the key: dird uses one service token, renewed often
        proxy_cache_key "$http_wazo_tenant$request_uri";
        proxy_cache_valid 200 60s;
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_lock on;
        proxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;
        proxy_cache_bypass $wazo_confd_users_skip;
        proxy_no_cache $wazo_confd_users_skip;

        add_header X-Cache-Status $upstream_cache_status;
    }

    location / {
        proxy_pass http://127.0.0.1:9486;
        proxy_set_header Host $http_host;
        proxy_read_timeout 180s;
    }
}
